{
  "schemaVersion": 1,
  "product": "AI-WPS",
  "version": "0.23.1-alpha",
  "releaseDate": "20260812",
  "versionRule": "AI-WPS-P1-WORD-EXCEL-PPT-0.23.1-20260812",
  "hosts": [
    {
      "name": "Word",
      "plugin": "wps-ai-assistant_1.0.0",
      "ribbonType": "wps"
    },
    {
      "name": "Excel",
      "plugin": "wps-ai-assistant-et_1.0.0",
      "ribbonType": "et"
    },
    {
      "name": "PPT",
      "plugin": "wps-ai-assistant-wpp_1.0.0",
      "ribbonType": "wpp"
    }
  ],
  "adapter": {
    "name": "wps-ai-adapter",
    "version": "0.23.1-alpha",
    "accessMethods": [
      "workflow_platform",
      "direct_model"
    ],
    "systemPromptManifest": "packages/adapter-start-kit/adapter_service/system_prompts/manifest.json",
    "systemPromptCount": 8,
    "pythonRuntimeGate": "scripts/python38_delivery_runtime_gate.py",
    "lifecycleGate": "scripts/python38_delivery_lifecycle_gate.py",
    "minimumPython": "3.8",
    "privateRuntime": {
      "path": "python-runtime/",
      "lock": "packages/kylin-v10-arm-py38/requirements-lock.txt",
      "hashManifest": "packages/kylin-v10-arm-py38/SHA256SUMS",
      "disableUserSite": true
    }
  },
  "deliveryPolicy": {
    "status": "candidate",
    "sourceAssembly": "explicit-allowlist",
    "allowlist": "release-allowlist.json",
    "fileHashes": "release-file-hashes.json",
    "auditScript": "scripts/audit_delivery.py",
    "lifecycleGate": "scripts/python38_delivery_lifecycle_gate.py",
    "targetAcceptanceRequired": true
  },
  "excelFormulaAssistantAssets": {
    "operationsGuide": "docs/operations/dify-excel-formula-assistant-workflow.md",
    "promptTemplate": "docs/prompt-templates/excel-formula-assistant-prompt-template.md"
  },
  "pptStructureReviewAssets": {
    "operationsGuide": "docs/operations/dify-ppt-structure-review-workflow.md",
    "promptTemplate": "docs/prompt-templates/ppt-structure-review-prompt-template.md"
  },
  "writingPolicyPacks": [
    "yangqi-tech-writing-base",
    "technical-document-style",
    "official-document-style",
    "cybersecurity-terminology"
  ],
  "writingPolicyAssets": {
    "schema": "packages/adapter-start-kit/adapter_service/writing_policy_packs/schema-v1.json",
    "sources": "docs/writing-policy-sources.md",
    "notices": "packages/adapter-start-kit/adapter_service/writing_policy_packs/THIRD_PARTY_NOTICES.md",
    "csvTemplate": "docs/import-templates/writing-policies-import-template.csv",
    "xlsxTemplate": "docs/import-templates/writing-policies-import-template.xlsx"
  },
  "runtimeStatePolicy": {
    "sharedStateEnv": "AI_WPS_STATE_DIR",
    "backupEnv": "AI_WPS_BACKUP_DIR",
    "runtimeVarEnv": "AI_WPS_VAR_DIR",
    "legacyLayoutFallback": true,
    "snapshotRoot": "state/",
    "snapshotExcluded": [
      "backups/",
      "var/logs/",
      "var/run/",
      "var/transactions/"
    ],
    "firstInstall": "initialize-empty-organization-database",
    "upgrade": "copy-on-write-migration-with-consistent-snapshot",
    "snapshotManifestSchemaVersion": 1,
    "copyVerificationField": "copyVerified",
    "minimumValidSnapshots": 3,
    "wholeStateRestoreOnly": true,
    "recoveryActivation": {
      "automaticSwitch": false,
      "explicitFlag": "--activate-recovery",
      "terminalStatus": "recovery_activated"
    },
    "recoveryApi": {
      "createReadOnlyBackup": "POST /recovery/backups",
      "sanitizedDiagnostics": "GET /recovery/diagnostics",
      "restoreEndpoint": null
    },
    "excluded": [
      "writing_policies.db",
      "writing_policies.db.backup-*",
      "provider_api_key",
      "provider_api_keys/",
      "adapter.json",
      "logs/",
      "imported-user-content",
      "unapproved-review-drafts"
    ]
  },
  "releaseGenerationPolicy": {
    "releaseRoot": "releases/<version>/",
    "currentPointer": "current",
    "transactionLogRoot": "var/transactions/",
    "switchStrategy": "durable-compensating-rename",
    "components": [
      "adapter_release",
      "word_plugin",
      "excel_plugin",
      "ppt_plugin",
      "publish_manifest",
      "runtime_state_snapshot",
      "current_pointer"
    ]
  }
}
